# ========================================================
# AI Assignment & Study Material Generator Configuration
# Provide any ONE (or more) of the API keys below.
# ========================================================

# 1. Google Gemini API (Recommended for free/high quota)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. OpenRouter API (Access Claude, Llama 3, DeepSeek, GPT-4o)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 3. OpenAI API (Direct OpenAI models)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Default Model Selection (Optional)
# Examples: gemini-1.5-flash, gemini-2.0-flash, gpt-4o-mini, meta-llama/llama-3.3-70b-instruct
DEFAULT_MODEL=gemini-1.5-flash
